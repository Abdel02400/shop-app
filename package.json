{
    "name": "shop-app",
    "version": "0.1.0",
    "private": true,
    "description": "Plateforme e-commerce monorepo. Boutique curated, dropshipping pur.",
    "license": "UNLICENSED",
    "scripts": {
        "prepare": "husky",
        "dev": "pnpm --dir apps/front dev",
        "build": "pnpm --dir apps/front build",
        "start": "pnpm --dir apps/front start",
        "lint": "pnpm --dir apps/front lint",
        "lint:fix": "pnpm --dir apps/front lint:fix",
        "format": "pnpm --dir apps/front format",
        "format:check": "pnpm --dir apps/front format:check",
        "type-check": "pnpm --dir apps/front exec tsc --noEmit"
    },
    "lint-staged": {
        "apps/front/**/*.{ts,tsx,js,jsx}": [
            "pnpm --dir apps/front exec eslint --fix",
            "pnpm --dir apps/front exec prettier --write"
        ],
        "apps/front/**/*.{json,css,md}": [
            "pnpm --dir apps/front exec prettier --write"
        ]
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0"
    }
}
